{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runbook.dev/schemas/pdl-core-0.1.json",
  "title": "Runbook PDL Core Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "snapshot_id", "as_of", "page"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pdl-core/0.1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "style": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["css_ref", "source_type", "source_key"],
          "properties": {
            "css_ref": { "type": "string", "minLength": 1 },
            "source_type": {
              "type": "string",
              "enum": ["manual", "default", "theme"]
            },
            "source_key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        { "type": "null" }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_type", "blocks"],
      "properties": {
        "page_type": {
          "type": "string",
          "enum": ["grid", "flex_grid", "custom"]
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "page_type": { "const": "grid" }
            }
          },
          "then": {
            "required": ["rows", "columns"]
          },
          "else": {
            "if": {
              "properties": {
                "page_type": { "const": "flex_grid" }
              }
            },
            "then": {
              "required": ["rows", "columns"]
            },
            "else": {
              "not": {
                "anyOf": [
                  { "required": ["rows"] },
                  { "required": ["columns"] }
                ]
              }
            }
          }
        }
      ]
    },
    "artifacts": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plots": {
              "type": ["array", "null"],
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "tables": {
              "type": ["array", "null"],
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "files": {
              "type": ["array", "null"],
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        { "type": "null" }
      ]
    },
    "extensions": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "blockBase": {
      "type": "object",
      "required": ["type", "name", "row", "col"],
      "properties": {
        "type": { "type": "string" },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\.]+$"
        },
        "title": { "type": ["string", "null"] },
        "row": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 1 },
        "row_span": { "type": "integer", "minimum": 1, "default": 1 },
        "col_span": { "type": "integer", "minimum": 1, "default": 1 },
        "extensions": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "tableBlock": {
      "allOf": [
        { "$ref": "#/$defs/blockBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "data_ref"],
          "properties": {
            "name": { "$ref": "#/$defs/blockBase/properties/name" },
            "title": { "$ref": "#/$defs/blockBase/properties/title" },
            "row": { "$ref": "#/$defs/blockBase/properties/row" },
            "col": { "$ref": "#/$defs/blockBase/properties/col" },
            "row_span": { "$ref": "#/$defs/blockBase/properties/row_span" },
            "col_span": { "$ref": "#/$defs/blockBase/properties/col_span" },
            "extensions": { "$ref": "#/$defs/blockBase/properties/extensions" },
            "type": { "const": "table" },
            "data_ref": { "type": "string", "minLength": 1 },
            "style_ref": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ],
              "default": null
            },
            "html_ref": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ],
              "default": null
            },
            "style_key": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ],
              "default": null
            },
            "columns": {
              "type": ["array", "null"],
              "items": { "$ref": "#/$defs/column" },
              "uniqueItems": true,
              "x-runbook-unique-by": "field"
            }
          }
        }
      ]
    },
    "plotRefBlock": {
      "allOf": [
        { "$ref": "#/$defs/blockBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ref"],
          "properties": {
            "name": { "$ref": "#/$defs/blockBase/properties/name" },
            "title": { "$ref": "#/$defs/blockBase/properties/title" },
            "row": { "$ref": "#/$defs/blockBase/properties/row" },
            "col": { "$ref": "#/$defs/blockBase/properties/col" },
            "row_span": { "$ref": "#/$defs/blockBase/properties/row_span" },
            "col_span": { "$ref": "#/$defs/blockBase/properties/col_span" },
            "extensions": { "$ref": "#/$defs/blockBase/properties/extensions" },
            "type": { "const": "plot_ref" },
            "ref": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "textBlock": {
      "allOf": [
        { "$ref": "#/$defs/blockBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "name": { "$ref": "#/$defs/blockBase/properties/name" },
            "title": { "$ref": "#/$defs/blockBase/properties/title" },
            "row": { "$ref": "#/$defs/blockBase/properties/row" },
            "col": { "$ref": "#/$defs/blockBase/properties/col" },
            "row_span": { "$ref": "#/$defs/blockBase/properties/row_span" },
            "col_span": { "$ref": "#/$defs/blockBase/properties/col_span" },
            "extensions": { "$ref": "#/$defs/blockBase/properties/extensions" },
            "type": { "const": "text" },
            "text": { "type": "string" },
            "format": { "type": ["string", "null"], "enum": ["plain", "markdown", null] }
          }
        }
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"], "minLength": 1 },
        "role": {
          "type": ["string", "null"],
          "enum": ["dimension", "measure", "time", "identifier", null]
        },
        "aggregation": {
          "type": ["string", "null"],
          "enum": ["sum", "avg", "min", "max", "count", "first", "last", null]
        },
        "format": {
          "oneOf": [
            { "$ref": "#/$defs/numberFormat" },
            { "$ref": "#/$defs/currencyFormat" },
            { "$ref": "#/$defs/percentFormat" },
            { "$ref": "#/$defs/dateFormat" },
            { "$ref": "#/$defs/datetimeFormat" },
            { "type": "null" }
          ]
        },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "numberFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "number" },
        "decimals": { "type": ["integer", "null"], "minimum": 0, "maximum": 12 }
      }
    },
    "currencyFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "currency"],
      "properties": {
        "kind": { "const": "currency" },
        "currency": { "type": "string", "minLength": 1 },
        "decimals": { "type": ["integer", "null"], "minimum": 0, "maximum": 12 }
      }
    },
    "percentFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "percent" },
        "decimals": { "type": ["integer", "null"], "minimum": 0, "maximum": 12 }
      }
    },
    "dateFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "date" }
      }
    },
    "datetimeFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "datetime" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/plotRefBlock" },
        { "$ref": "#/$defs/textBlock" }
      ]
    }
  }
}
