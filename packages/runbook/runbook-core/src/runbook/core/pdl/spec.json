{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runbook.dev/schemas/pdl-core-0.1.json",
  "title": "Runbook PDL Core Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "snapshot_id", "as_of", "page"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pdl-core/0.1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["css_ref", "source_type", "source_key"],
      "properties": {
        "css_ref": { "type": "string", "minLength": 1 },
        "source_type": {
          "type": "string",
          "enum": ["manual", "default", "theme"]
        },
        "source_key": {
            "type": "string",
            "minLength": 1
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_type", "blocks"],
      "properties": {
        "page_type": {
          "type": "string",
          "enum": ["grid", "flex_grid", "custom"]
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "page_type": { "const": "grid" }
            }
          },
          "then": {
            "required": ["rows", "columns"]
          },
          "else": {
            "if": {
              "properties": {
                "page_type": { "const": "flex_grid" }
              }
            },
            "then": {
              "required": ["rows", "columns"]
            },
            "else": {
              "not": {
                "anyOf": [
                  { "required": ["rows"] },
                  { "required": ["columns"] }
                ]
              }
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tables": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "blockBase": {
      "type": "object",
      "required": ["type", "name", "row", "col"],
      "properties": {
        "type": { "type": "string" },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\.]+$"
        },
        "title": { "type": "string" },
        "row": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 1 },
        "row_span": { "type": "integer", "minimum": 1, "default": 1 },
        "col_span": { "type": "integer", "minimum": 1, "default": 1 },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "tableBlock": {
      "allOf": [
        { "$ref": "#/$defs/blockBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "data_ref"],
          "properties": {
            "type": { "const": "table" },
            "data_ref": { "type": "string", "minLength": 1 },
            "style_ref": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ],
              "default": null
            },
            "html_ref": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ],
              "default": null
            },
            "style_key": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ],
              "default": null
            }
          }
        }
      ]
    },
    "plotRefBlock": {
      "allOf": [
        { "$ref": "#/$defs/blockBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ref"],
          "properties": {
            "type": { "const": "plot_ref" },
            "ref": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "textBlock": {
      "allOf": [
        { "$ref": "#/$defs/blockBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" },
            "format": { "type": "string", "enum": ["plain", "markdown"] }
          }
        }
      ]
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/plotRefBlock" },
        { "$ref": "#/$defs/textBlock" }
      ]
    }
  }
}
